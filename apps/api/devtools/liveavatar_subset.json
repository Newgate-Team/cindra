   "VoiceAgentRef": {
    "description": "Reference to a stored voice_agent, plus optional per-session overrides.\n\nThe caller passes only the agent ``id``; the server resolves the stored\nagent's ``agent_type`` and decides how the session is built. The override\nfields below are NOT universal — which ones are accepted depends on the\nresolved type, and an override that doesn't apply is rejected (400) rather\nthan silently ignored:\n\n* ``liveavatar_agent`` (managed STT -> LLM -> TTS pipeline): ``language``\n  and ``dynamic_variables`` are honored, layered over the stored agent's\n  config for this session only.\n* ``elevenlabs_agent`` (ElevenLabs-hosted): the stored agent is used as-is;\n  passing ``language`` or ``dynamic_variables`` is rejected with a 400.\n\nOverrides are per-session-at-creation choices, not properties of the stored\nagent — the same agent is reused across sessions with different values each\ntime, and the resolved result is what gets frozen into the session snapshot.\nShared across the SDK and app token requests.\n\n``dynamic_variables`` is typed as the bounded union for forward-compatibility\n(a single wire type across agent types); the server narrows or rejects it per\nthe resolved ``agent_type`` as described on the field.",
    "properties": {
     "dynamic_variables": {
      "additionalProperties": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "integer"
        },
        {
         "type": "number"
        },
        {
         "type": "boolean"
        }
       ]
      },
      "description": "Per-session dynamic_variables override. Accepted only for a liveavatar_agent, where values must be strings (substituted as text into the context's ${var} placeholders; non-string values are rejected with a 400). Rejected with a 400 for an elevenlabs_agent. Mutually exclusive with the top-level dynamic_variables (400 if both set). At most 50 entries; keys <= 64 chars; string values <= 1000 chars.",
      "title": "Dynamic Variables",
      "type": "object"
     },
     "id": {
      "description": "Stored voice_agent id. Its server-resolved agent_type determines which of the override fields below are accepted.",
      "format": "uuid",
      "title": "Id",
      "type": "string"
     },
     "language": {
      "description": "Per-session language override, layered over the agent's stored language. Accepted only for a liveavatar_agent; rejected with a 400 for an elevenlabs_agent.",
      "title": "Language",
      "type": "string"
     }
    },
    "required": [
     "id"
    ],
    "title": "VoiceAgentRef",
    "type": "object"
   }
  },
