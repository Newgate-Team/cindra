# Скопировать в .env (gitignored) и заполнить реальными значениями для локальной разработки.
# Значения ниже соответствуют infra/docker-compose.yml.

DATABASE_URL=postgresql+psycopg://cindra:cindra@localhost:5433/cindra
REDIS_URL=redis://localhost:6380/0

# Сгенерировать реальный секрет для локальной разработки: openssl rand -hex 32
JWT_SECRET=dev-only-insecure-secret-change-in-.env

# Ключ шифрования OAuth-токенов соцсетей в БД (Fernet). Сгенерировать:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SOCIAL_TOKEN_ENCRYPTION_KEY=miLbnE1KsbWEH0uvZOPC03XFYh_NydEqOpPk0KVAn18=

# См. гейт-тикет CIN-49 -- без ключа генерация текста реально
# доходит до Anthropic и падает с настоящей 401.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# См. гейт-тикет CIN-51 -- получить через @BotFather в Telegram.
TELEGRAM_BOT_TOKEN=

# См. гейт-тикет CIN-52 -- Meta App + Instagram Business Account,
# требует App Review для нужных разрешений.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://app.cindra.example/oauth/instagram/callback
