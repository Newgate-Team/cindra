# Скопировать в .env (gitignored) и заполнить реальными значениями для локальной разработки.
# Значения ниже соответствуют infra/docker-compose.yml.

DATABASE_URL=postgresql+psycopg://cindra:cindra@localhost:5433/cindra
REDIS_URL=redis://localhost:6380/0

# Сгенерировать реальный секрет для локальной разработки: openssl rand -hex 32
JWT_SECRET=dev-only-insecure-secret-change-in-.env

# Ключ шифрования OAuth-токенов соцсетей в БД (Fernet). Сгенерировать:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SOCIAL_TOKEN_ENCRYPTION_KEY=miLbnE1KsbWEH0uvZOPC03XFYh_NydEqOpPk0KVAn18=

# CIN-160 -- отдельный Fernet-ключ (не тот же, что выше) для ежедневных
# бэкапов Postgres: они лежат в том же публичном R2-бакете, что и медиа
# (см. README "Бэкапы"), поэтому дамп шифруется перед загрузкой.
# Сгенерировать так же, как ключ выше.
BACKUP_ENCRYPTION_KEY=

# См. задачи CIN-53/54/55 -- один ключ для всего Google AI-стека
# (текст/фото/видео). Получить ключ: https://aistudio.google.com/apikey
# ВАЖНО: generativelanguage.googleapis.com блокирует запросы по геолокации
# IP ("User location is not supported") -- подтверждено для сетей в
# Казахстане, локальная разработка оттуда может потребовать VPN. На
# Railway (US/EU) это не ожидается как проблема.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
IMAGE_MODEL=gemini-2.5-flash-image
VEO_MODEL=veo-3.1-fast-generate-preview

# См. CIN-144 -- ключ fal.ai (fal.ai -> Dashboard -> Keys). Пока пуст,
# «Полное авто» в видео-студии генерирует через Veo; с ключом --
# Seedance 2.5 (до 30 секунд с озвучкой). Внимание: Seedance дороже
# Veo за секунду -- перед включением в прод см. пересчёт лимитов CIN-146.
FAL_KEY=

# См. CIN-133 -- OAuth 2.0 Web client ID из Google Cloud Console
# (APIs & Services -> Credentials -> Create OAuth client ID, тип Web).
# В Authorized JavaScript origins добавить домен фронтенда (и
# http://localhost:3000 для локальной разработки). Тот же ID идёт во
# фронтенд как NEXT_PUBLIC_GOOGLE_CLIENT_ID. Пусто = вход через Google
# выключен (кнопка скрыта, эндпоинт отвечает 503).
GOOGLE_CLIENT_ID=

# См. гейт-тикет CIN-51 -- получить через @BotFather в Telegram.
TELEGRAM_BOT_TOKEN=

# См. гейт-тикет CIN-52 -- Meta App + Instagram Business Account,
# требует App Review для нужных разрешений.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://app.cindra.example/oauth/instagram/callback

# TikTok Developer Portal -> Login Kit + Content Posting API.
# Redirect URI must match the registered value exactly.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://cindra-chi.vercel.app/oauth/tiktok/callback

# Google Cloud Console -> a SEPARATE OAuth client from GOOGLE_CLIENT_ID
# above (that one is Google Sign-In only, no refresh token; this one
# needs offline access + the youtube.upload scope). Redirect URI must
# be registered verbatim there, same as TikTok's. Video-only.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=https://cindra-chi.vercel.app/oauth/youtube/callback

# LinkedIn Developer Portal -> "Sign In with LinkedIn using OpenID
# Connect" + "Share on LinkedIn" products (both auto-approved, no
# partner review). Text + image only -- video is not implemented.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://cindra-chi.vercel.app/oauth/linkedin/callback
# YYYYMM version string LinkedIn's REST API requires on every call --
# confirm this is still current against LinkedIn's Developer Portal
# docs before relying on it, they deprecate old versions ~yearly.
LINKEDIN_API_VERSION=202501

# Reddit "web app" (script-type app, not "installed app") from
# reddit.com/prefs/apps. Text + image + video, via link posts pointing
# at Cindra's own hosted media, not Reddit's native asset upload.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_REDIRECT_URI=https://cindra-chi.vercel.app/oauth/reddit/callback
# Reddit rejects/rate-limits requests with a generic User-Agent --
# must be descriptive and app-unique, ideally including your Reddit
# username per Reddit's own API rules.
REDDIT_USER_AGENT=cindra/1.0 (web app; by /u/your-reddit-username)

# X (Twitter) Developer Portal -> a confidential (server-side) OAuth
# 2.0 client. Text only -- no media upload. IMPORTANT: since 2023, X's
# free API tier does not include write access to POST /2/tweets at
# all -- confirm your plan actually includes tweet-write access before
# relying on this.
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_REDIRECT_URI=https://cindra-chi.vercel.app/oauth/twitter/callback

# См. CIN-18 -- PayPal Developer Dashboard (developer.paypal.com) ->
# Apps & Credentials -> Create App даёт Client ID/Secret. sandbox для
# разработки, live -- после реального Business-аккаунта.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
# См. CIN-87 -- создаются вместе с Product/Plan в PayPal.
PAYPAL_PRO_PLAN_ID=
PAYPAL_BUSINESS_PLAN_ID=
# См. CIN-86 -- Apps & Credentials -> приложение -> Add Webhook в
# PayPal Developer Dashboard (нужен публичный URL, например ngrok).
PAYPAL_WEBHOOK_ID=
